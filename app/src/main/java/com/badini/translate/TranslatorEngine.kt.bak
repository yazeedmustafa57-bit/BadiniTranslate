        "i should" to "Divê ez",
        "i would like" to "Ez dixwazim",
        "would you like" to "Tu dixwazî",
        "let me" to "Bihêle ez",
        "allow me" to "Destûrê bidin min",
    )

    /** Reverse map: Badini -> English */
    private val BADINI_TO_EN: Map<String, String> by lazy {
        EN_TO_BADINI.entries.associate { (k, v) -> v.lowercase() to k }
    }
    data class TranslationResult(
        val translatedText: String,
        val alternateScriptText: String = "",
        val engine: String = ""
    )

    data class OcrResult(
        val extractedText: String,
        val translatedText: String,
        val alternateScriptText: String = "",
        val engine: String = ""
    )

    // ============================================================
    //  MAIN TRANSLATE FUNCTION
    // ============================================================

    suspend fun translate(text: String, from: String, to: String): TranslationResult {
        if (text.isBlank()) return TranslationResult("")

        _lastTranslationErrors.clear()

        // 1) Try offline dictionary first (always works)
        val dictResult = translateOffline(text, from, to)
        if (dictResult != null) return dictResult


        // 2) If Badini is involved, try Badini API first
        if (to == "badini" || from == "badini") {
            try {
                return translateWithBadiniAPI(text, from, to)
            } catch (e: Exception) {
                _lastTranslationErrors.add("Badini-API: ${e.message}")
                android.util.Log.w("Badini", "Badini API: ${e.message}")
            }

            try {
                return translateWithGemini(text, from, to)
            } catch (e: Exception) {
                _lastTranslationErrors.add("Gemini: ${e.message}")
                android.util.Log.w("Badini", "Gemini: ${e.message}")
            }
        } else {
            try {
                return translateWithGemini(text, from, to)
            } catch (e: Exception) {
                _lastTranslationErrors.add("Gemini: ${e.message}")
                android.util.Log.w("Badini", "Gemini: ${e.message}")
            }
        }

        // 5) Try MyMemory (funktioniert ohne API-Key für die meisten Sprachen)
        try {
            return translateWithMyMemory(text, from, to)
        } catch (e: Exception) {
            _lastTranslationErrors.add("MyMemory: ${e.message}")
            android.util.Log.w("Badini", "MyMemory: ${e.message}")
        }



        val errorDetails = _lastTranslationErrors.joinToString("\n• ")
        android.util.Log.w("Badini", "All translators failed:\n$errorDetails")
        return TranslationResult(
            "Übersetzung fehlgeschlagen.\n\n" +
            "Mögliche Ursachen:\n" +
            "• Badini-API: Tageslimit erreicht (0:00 Uhr geht's wieder)\n" +
            "• Gemini-API: Standard-Schlüssel aufgebraucht\n" +
            "• MyMemory: temporär nicht erreichbar\n\n" +
            "➡️ In den Einstellungen (⚙️) kannst du einen eigenen\n" +
            "   Gemini-API-Key hinterlegen (kostenlos auf\n" +
            "   https://aistudio.google.com/app/apikey)",
            engine = "Fehler"
        )
    }

    // ============================================================
    //  OFFLINE DICTIONARY – 800+ words & phrases
    // ============================================================

    /**
     * Offline Kurdish-Badini ↔ English dictionary.
     * Returns the translated text if found, or null to fall through to online APIs.
     */
    private fun translateOffline(text: String, from: String, to: String): TranslationResult? {
        val cleaned = text.trim().lowercase().replace(Regex("""[.!?,\s]+$"""), "")
        if (cleaned.isBlank()) return null

        // We support: en→badini and badini→en
        if (from == "badini" && to == "en") {
            val result = BADINI_TO_EN[cleaned]
            if (result != null) return TranslationResult(result, engine = "Wörterbuch")
            // check if it contains known words
            val words = cleaned.split(Regex("\\s+"))
            if (words.size <= 4) {
                val translated = words.map { BADINI_TO_EN[it] ?: it }.joinToString(" ")
                if (translated != cleaned) return TranslationResult(translated, engine = "Wörterbuch")
            }
        }
        if (from == "en" && to == "badini") {
            val result = EN_TO_BADINI[cleaned]
            if (result != null) return TranslationResult(result, engine = "Wörterbuch")
            val words = cleaned.split(Regex("\\s+"))
            if (words.size <= 4) {
                val translated = words.map { EN_TO_BADINI[it] ?: it }.joinToString(" ")
                if (translated != cleaned) return TranslationResult(translated, engine = "Wörterbuch")
            }
        }
        // Badini → any other language → try English as pivot
        if (from == "badini" && to != "en" && to != "badini") {
            val enResult = BADINI_TO_EN[cleaned]
            if (enResult != null) return TranslationResult("[$enResult] (Badini→${languageNames[to] ?: to} offline)", engine = "Wörterbuch")
        }
        return null
    }

    // ============================================================
    //  BADINI API
    // ============================================================

    private suspend fun translateWithBadiniAPI(text: String, from: String, to: String): TranslationResult {
        return withContext(Dispatchers.IO) {
            // Build list of available Badini API keys
            val allBadiniKeys = mutableListOf<String>()
            userBadiniKey?.let { if (it.isNotBlank()) allBadiniKeys.add(it) }
            allBadiniKeys.addAll(BADINI_KEYS)

            // Try via website proxy first - needs x-api-key header!
            try {
                val proxyBase = if (proxyUrl.endsWith("/")) proxyUrl.dropLast(1) else proxyUrl
                val url = URL("$proxyBase/api/proxy")
                val conn = url.openConnection() as HttpURLConnection
                conn.requestMethod = "POST"
                conn.setRequestProperty("Content-Type", "application/json")
                // The Vercel proxy requires x-api-key header to forward the request
                if (allBadiniKeys.isNotEmpty()) {
                    conn.setRequestProperty("x-api-key", allBadiniKeys[0])
                }
                conn.doOutput = true
                conn.connectTimeout = 8000
                conn.readTimeout = 15000

                val jsonBody = """{"text":"${escapedJson(text)}","languageFrom":"$from","languageTo":"$to"}"""
                OutputStreamWriter(conn.outputStream).use { it.write(jsonBody) }

                if (conn.responseCode == 200) {
                    val response = conn.inputStream.bufferedReader().readText()
                    val translated = extractNestedTranslated(response)
                    var alt = extractJsonValue(response, "alternateScriptText") ?: ""
                    if (translated != null) {
                        return@withContext TranslationResult(translated, alt, "Badini-Proxy")
                    }
                }
                conn.disconnect()
            } catch (e: Exception) { android.util.Log.w("Badini", "Proxy: ${e.message}") }

            // Fall back to direct Badini API with remaining keys
            for (key in allBadiniKeys.drop(1)) { // skip first key (already used by proxy)
                try {
                    val url = URL(BADINI_API_URL)
                    val conn = url.openConnection() as HttpURLConnection
                    conn.requestMethod = "POST"
                    conn.setRequestProperty("Content-Type", "application/json")
                    conn.setRequestProperty("x-api-key", key)
                    conn.setRequestProperty("Origin", "https://badini.app")
                    conn.doOutput = true
                    conn.connectTimeout = 5000
                    conn.readTimeout = 8000

                    val jsonBody = """{"text":"${escapedJson(text)}","languageFrom":"$from","languageTo":"$to"}"""
                    OutputStreamWriter(conn.outputStream).use { it.write(jsonBody) }

                    if (conn.responseCode == 200) {
                        val response = conn.inputStream.bufferedReader().readText()
                        val translated = extractNestedTranslated(response)
                        val alt = extractJsonValue(response, "alternateScriptText") ?: ""
                        if (translated != null) {
                            return@withContext TranslationResult(translated, alt, "Badini-API")
                        }
                    } else if (conn.responseCode == 429) {
                        conn.disconnect()
                        Thread.sleep(500)
                        continue
                    }
                    conn.disconnect()
                } catch (e: Exception) {
                    if (e.message?.contains("429") == true || e.message?.contains("Too Many Requests") == true) {
                        Thread.sleep(500)
                    }
                    continue
                }
            }
            throw Exception("Badini API fehlgeschlagen")
        }
    }
    // ============================================================

    private suspend fun translateWithGemini(text: String, from: String, to: String): TranslationResult {
        return withContext(Dispatchers.IO) {
            val fromName = languageNames[from] ?: from
            val toName = languageNames[to] ?: to

            val prompt = """You are a professional translator. Translate the following text from $fromName to $toName.

Rules:
- Return ONLY the translated text, nothing else.
- Do NOT add any explanations, notes, or commentary.
- Preserve the original formatting and line breaks.
- If $toName uses a different script (e.g. Arabic script for Badini Kurdish), use that script.
- IMPORTANT: If translating TO Badini Kurdish, ALSO provide the Latin (Roman) script version.
  Format your response EXACTLY like this:
  [ARABIC_SCRIPT]
  [LATIN_SCRIPT]
  The first line is the Arabic script (Badini), the second line is the Latin script version.
  If NOT translating to Badini, just return the translation as normal.

Text to translate:
$text"""

            for (key in allGeminiKeys) {
                try {
                    val result = callGeminiAPI(key, prompt)
                    if (result != null) return@withContext result
                } catch (e: Exception) {
                    if (e.message?.contains("429") == true || e.message?.contains("Too Many Requests") == true) {
                        Thread.sleep(300)
                        continue
                    }
                }
            }
            throw Exception("Alle Gemini-Keys fehlgeschlagen")
        }
    }

    private fun callGeminiAPI(apiKey: String, prompt: String): TranslationResult? {
        val models = listOf("gemini-2.0-flash", "gemini-1.5-flash")
        for (model in models) {
            try {
                val url = URL("https://generativelanguage.googleapis.com/v1beta/models/$model:generateContent?key=$apiKey")
                val conn = url.openConnection() as HttpURLConnection
                conn.requestMethod = "POST"
                conn.setRequestProperty("Content-Type", "application/json")
                conn.doOutput = true
                conn.connectTimeout = 3000
                conn.readTimeout = 3000

                val jsonBody = """{
                    "contents": [{"parts": [{"text": ${jsonString(prompt)}}]}],
                    "generationConfig": {"temperature": 0.1, "maxOutputTokens": 8192}
                }"""
                OutputStreamWriter(conn.outputStream).use { it.write(jsonBody) }

                if (conn.responseCode == 200) {
                    val response = conn.inputStream.bufferedReader().readText()
                    val result = extractGeminiText(response)
                    if (result != null) return result
                } else if (conn.responseCode == 429) {
                    conn.disconnect()
                    throw Exception("429 Too Many Requests for key")
                }
                conn.disconnect()
            } catch (e: Exception) {
                if (e.message?.contains("429") == true || e.message?.contains("Too Many Requests") == true) {
                    throw e
                }
                continue
            }
        }
        return null
    }

    // ============================================================
// ============================================================

    private suspend fun translateWithMyMemory(text: String, from: String, to: String): TranslationResult {
        return withContext(Dispatchers.IO) {
            try {
                val lf = normalizeLangCode(from)
                val lt = normalizeLangCode(to)
                val q = java.net.URLEncoder.encode(text, "UTF-8")
                val url = URL("https://api.mymemory.translated.net/get?q=$q&langpair=$lf|$lt&de=demo@example.com")
                val conn = url.openConnection() as HttpURLConnection
                conn.requestMethod = "GET"
                conn.connectTimeout = 3000
                conn.readTimeout = 3000

                if (conn.responseCode == 200) {
                    val resp = conn.inputStream.bufferedReader().readText()
                    // parse {"responseData":{"translatedText":"...","match":1.0}}
                    val regex = """"translatedText"\s*:\s*"((?:[^"\\]|\\.)*)"""".toRegex()
                    val match = regex.find(resp)
                    if (match != null) {
                        val translated = match.groupValues[1]
                            .replace("\\n", "\n").replace("\\\"", "\"").replace("\\\\", "\\")
                        return@withContext TranslationResult(translated, "", "MyMemory")
                    }
                }
                conn.disconnect()
            } catch (e: Exception) { /* fall through */ }
            throw Exception("MyMemory fehlgeschlagen")
        }
    }

    // ============================================================
    //  IMAGE OCR + TRANSLATION
    // ============================================================

    suspend fun translateImage(bitmap: Bitmap, from: String, to: String): OcrResult {
        return withContext(Dispatchers.IO) {
            val stream = ByteArrayOutputStream()
            bitmap.compress(Bitmap.CompressFormat.JPEG, 85, stream)
            val imageBytes = stream.toByteArray()
            val base64 = android.util.Base64.encodeToString(imageBytes, android.util.Base64.NO_WRAP)

            val fromName = languageNames[from] ?: from
            val toName = languageNames[to] ?: to
            val prompt = "Extract all text from this image. Then translate the extracted text from $fromName to $toName. " +
                "Format your response as\nEXTRACTED: [extracted text]\nTRANSLATED: [translated text]"

            var lastError: String? = null

            // 1) Try Gemini-Vision first
            for (key in allGeminiKeys) {
                try {
                    val url = URL("https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=$key")
                    val conn = url.openConnection() as HttpURLConnection
                    conn.requestMethod = "POST"
                    conn.setRequestProperty("Content-Type", "application/json")
                    conn.doOutput = true
                    conn.connectTimeout = 3000
                    conn.readTimeout = 8000

                    val jsonBody = "{" +
                            "\"contents\":[{" +
                            "\"parts\":[" +
                            "{\"text\":" + jsonString(prompt) + "}," +
                            "{\"inline_data\":{\"mime_type\":\"image/jpeg\",\"data\":\"" + base64 + "\"}}" +
                            "]}" +
                            "]," +
                            "\"generationConfig\":{\"temperature\":0.1,\"maxOutputTokens\":8192}" +
                            "}"
                    OutputStreamWriter(conn.outputStream).use { it.write(jsonBody) }

                    val code = conn.responseCode
                    if (code == 200) {
                        val response = conn.inputStream.bufferedReader().readText()
                        val geminiResult = extractGeminiText(response)
                        conn.disconnect()

                        if (geminiResult != null) {
                            val fullText = geminiResult.translatedText
                            val extracted = extractField(fullText, "EXTRACTED")
                            val translated = extractField(fullText, "TRANSLATED")
                            return@withContext OcrResult(
                                extractedText = extracted ?: fullText,
                                translatedText = translated ?: fullText,
                                alternateScriptText = geminiResult.alternateScriptText,
                                engine = "Gemini-Vision"
                            )
                        }
                    }
                    conn.disconnect()
                } catch (e: Exception) { lastError = e.message; continue }
            }

            // 2) Try free OCR.space API as fallback
            try {
                val body = "apikey=helloworld&base64Image=" +
                    java.net.URLEncoder.encode("data:image/jpeg;base64," + base64, "UTF-8") +
                    "&language=eng&OCREngine=2"
                val ocrUrl = URL("https://api.ocr.space/parse/image")
                val ocrConn = ocrUrl.openConnection() as HttpURLConnection
                ocrConn.requestMethod = "POST"
                ocrConn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
                ocrConn.doOutput = true
                ocrConn.connectTimeout = 30000
                ocrConn.readTimeout = 60000

                OutputStreamWriter(ocrConn.outputStream).use { writer -> writer.write(body as String) }

                if (ocrConn.responseCode == 200) {
                    val ocrResponse = ocrConn.inputStream.bufferedReader().readText()
                    ocrConn.disconnect()

                    // Parse OCR.space response using extractJsonValue
                    val extractedText = extractJsonValue(ocrResponse, "ParsedText")
                    if (extractedText != null && extractedText.isNotBlank()) {
                        val translationResult = if (from != to) {
                            try { translate(extractedText, from, to) }
                            catch (e: Exception) { TranslationResult(extractedText) }
                        } else {
                            TranslationResult(extractedText)
                        }
                        return@withContext OcrResult(
                            extractedText = extractedText,
                            translatedText = translationResult.translatedText,
                            engine = "OCR.space + " + (translationResult.engine.ifEmpty { "Worterbuch" })
                        )
                    }
                } else {
                    ocrConn.disconnect()
                }
            } catch (e: Exception) {
                android.util.Log.w("Badini", "OCR.space: ${e.message}")
            }

            OcrResult("", "OCR fehlgeschlagen.\nBitte Internetverbindung prüfen.")
        }
    }

    // ============================================================
    //  FILE READING
    // ============================================================

    suspend fun readTextFromUri(uri: Uri, contentResolver: ContentResolver): String {
        return withContext(Dispatchers.IO) {
            try {
                val inputStream = contentResolver.openInputStream(uri)
                    ?: return@withContext ""
                inputStream.bufferedReader().use { it.readText() }
            } catch (e: Exception) {
                android.util.Log.w("Badini", "readTextFromUri: ${e.message}")
                ""
            }
        }
    }

    // ============================================================
    //  HELPERS
    // ============================================================

    private fun normalizeLangCode(code: String): String {
        return when (code) {
            "badini" -> "ku"  // Kurdish
            else -> code
        }
    }

    private fun extractField(text: String, field: String): String? {
        val regex = Regex("""$field:\s*(.+?)(?:\n|$)""")
        return regex.find(text)?.groupValues?.get(1)?.trim()
    }

    private fun extractGeminiText(json: String): TranslationResult? {
        try {
            val regex = """"text"\s*:\s*"((?:[^"\\]|\\.)*)"""".toRegex()
            val matches = regex.findAll(json).toList()
            if (matches.isNotEmpty()) {
                val last = matches.last().groupValues[1]
                val raw = last.replace("\\n", "\n").replace("\\\"", "\"")?.replace("\\\\", "\\")
                // Check for dual-script format (Arabic + Latin)
                val lines = (raw ?: "").trim().split("\n")
                if (lines.size >= 2 && lines[1].trim().isNotEmpty()) {
                    return TranslationResult(lines[0].trim(), lines[1].trim(), "Gemini")
                }
                return TranslationResult((raw ?: "").trim(), "", "Gemini")
            }
            return null
        } catch (e: Exception) { return null }
    }

    private fun extractJsonValue(json: String, key: String): String? {
        val regex = Regex("""""$key\":\s*"((?:[^"\\]|\\.)*)"""")
        return regex.find(json)?.groupValues?.get(1)
            ?.replace("\\n", "\n")?.replace("\\\"", "\"")?.replace("\\\\", "\\")
    }

    private fun extractJsonValueRaw(json: String, key: String): String? {
        val pattern = """""$key":\s*\{((?:[^{}]|(?:\{[^{}]*\}))*)\}"""
        val regex = Regex(pattern)
        val match = regex.find(json)
        return match?.groupValues?.get(1)?.trim()
    }

    private fun extractNestedTranslated(json: String): String? {
        val regex = Regex("""""translatedText":\s*"((?:[^"\\]|\\.)*)"""")
        return regex.find(json)?.groupValues?.get(1)
            ?.replace("\\n", "\n")?.replace("\\\"", "\"")?.replace("\\\\", "\\")
    }

    private fun jsonString(s: String): String {
        return "\"" + s.replace("\\", "\\\\")
            .replace("\"", "\\\"").replace("\n", "\\n")
            .replace("\r", "\\r").replace("\t", "\\t") + "\""
    }

    private fun escapedJson(s: String): String {
        return s.replace("\\", "\\\\")
            .replace("\"", "\\\"").replace("\n", "\\n")
            .replace("\r", "\\r").replace("\t", "\\t")
    }

    // ============================================================
    //  LANGUAGE DETECTION
    // ============================================================

    fun detectLanguage(text: String): String {
        if (text.isBlank()) return "en"
        val t = text.trim()

        var arabicChars = 0
        var latinChars = 0
        var cjkChars = 0
        var totalLetters = 0

        for (c in t) {
            if (c in '\u0600'..'\u06FF' || c in '\u0750'..'\u077F' || c in '\u08A0'..'\u08FF' || c in '\uFB50'..'\uFDFF' || c in '\uFE70'..'\uFEFF') arabicChars++
            else if (c in '\u4E00'..'\u9FFF' || c in '\u3400'..'\u4DBF' || c in '\uF900'..'\uFAFF') cjkChars++
            else if (c.isLetter()) latinChars++
            if (c.isLetter()) totalLetters++
        }

        if (totalLetters == 0) return "en"

        val arabicRatio = arabicChars.toFloat() / totalLetters
        val latinRatio = latinChars.toFloat() / totalLetters

        // Arabic script block
        if (arabicRatio > 0.3f) {
            val lower = t.lowercase()
            val badiniWords = listOf(
                "ez", "tu", "ew", "em", "h\u00fbn", "awa", "bi x\u00ear", "spas",
                "\u00e7awa", "ba\u015f", "ne", "er\u00ea", "na", "min", "te", "w\u00ee", "w\u00ea",
                "me", "we", "wan", "hatin", "\u00e7\u00fbn", "kirin", "gotin", "d\u00eeytin",
                "xwarin", "vexwarin", "dan", "stendin", "zan\u00een", "xwastin",
                "kar\u00een", "div\u00ea", "heye", "tune", "li", "ji", "bi", "di", "ser",
                "bin", "nav", "der", "re", "b\u00fbn", "bike", "dike", "kiriye",
                "d\u00ea", "\u00ea", "dikin", "dike", "nakim", "nake", "bikin", "nekir"
            )
            var badiniScore = 0
            for (w in badiniWords) {
                if (lower.contains(w)) badiniScore++
            }

            val arabicWords = listOf(
                "\u0627\u0644\u0630\u064a", "\u0647\u0630\u0627", "\u062a\u0644\u0643",
                "\u0643\u0627\u0646", "\u0633\u0648\u0641", "\u0647\u0644", "\u0644\u0645",
                "\u0639\u0644\u0649", "\u0625\u0644\u0649", "\u0645\u0646", "\u0641\u064a",
                "\u0623\u0646\u0627", "\u0646\u062d\u0646", "\u0647\u0648", "\u0647\u064a"
            )
            var arabicScore = 0
            for (w in arabicWords) {
                if (lower.contains(w)) arabicScore++
            }

            var persianChars = 0
            for (c in t) {
                if (c == '\u06AF' || c == '\u0686' || c == '\u067E' || c == '\u0698') persianChars++
            }

            return when {
                persianChars > 0 -> "fa"
                badiniScore > arabicScore && badiniScore >= 2 -> "badini"
                arabicScore > badiniScore -> "ar"
                else -> "badini"
            }
        }

        // CJK
        if (cjkChars > totalLetters * 0.3f) {
            var japaneseChars = 0
            var koreanChars = 0
            for (c in t) {
                when {
                    c in '\u3040'..'\u309F' || c in '\u30A0'..'\u30FF' -> japaneseChars++
                    c in '\uAC00'..'\uD7AF' -> koreanChars++
                }
            }
            return when {
                koreanChars > totalLetters * 0.3f -> "ko"
                japaneseChars > 0 -> "ja"
                else -> "zh"
            }
        }

        // Cyrillic
        var cyrCount = 0
        var letCount = 0
        for (ch in t) {
            if (ch in '\u0400'..'\u04FF' || ch in '\u0500'..'\u052F') cyrCount++
            if (ch.isLetter()) letCount++
        }
        if (letCount > 0 && cyrCount.toFloat() / letCount > 0.3f) return "ru"

        // Latin script language detection
        val lower = t.lowercase()

        // Turkish specific chars
        for (c in t) {
            if (c == '\u015F' || c == '\u0131' || c == '\u011F' || c == '\u00FC' || c == '\u00F6' || c == '\u00E7' ||
                c == '\u015E' || c == '\u0130' || c == '\u011E' || c == '\u00DC' || c == '\u00D6' || c == '\u00C7') return "tr"
        }
        // Swedish chars
        for (c in t) {
            if (c == '\u00E5' || c == '\u00E4' || c == '\u00F6' || c == '\u00C5' || c == '\u00C4' || c == '\u00D6') return "sv"
        }

        val germanWords = listOf("der ", "die ", "das ", "ist ", "sind ", "nicht ", "und ", "mit ", "auf ", "ein ", "eine ", "f\u00fcr ", "ich ", "du ", "wir ", "sie ")
        var germanScore = 0
        for (w in germanWords) { if (lower.contains(w)) germanScore++ }
        val frenchWords = listOf("je ", "tu ", "il ", "elle ", "nous ", "vous ", "ils ", "elles ", "le ", "la ", "les ", "un ", "une ", "des ", "est ", "sont ", "pas ", "avec ")
        var frenchScore = 0
        for (w in frenchWords) { if (lower.contains(w)) frenchScore++ }
        val spanishWords = listOf("el ", "la ", "los ", "las ", "un ", "una ", "es ", "son ", "y ", "o ", "pero ", "con ", "por ", "para ")
        var spanishScore = 0
        for (w in spanishWords) { if (lower.contains(w)) spanishScore++ }
        val italianWords = listOf("il ", "la ", "le ", "gli ", "un ", "una ", "\u00e8 ", "sono ", "e ", "ma ", "con ", "per ", "che ")
        var italianScore = 0
        for (w in italianWords) { if (lower.contains(w)) italianScore++ }
        val dutchWords = listOf("de ", "het ", "een ", "is ", "zijn ", "niet ", "en ", "met ", "op ", "ik ", "je ", "we ", "ze ")
        var dutchScore = 0
        for (w in dutchWords) { if (lower.contains(w)) dutchScore++ }

        val scores = listOf(
            "de" to germanScore, "fr" to frenchScore, "es" to spanishScore,
            "it" to italianScore, "nl" to dutchScore
        ).filter { it.second > 0 }

        if (scores.isNotEmpty()) return scores.maxByOrNull { it.second }!!.first

        return "en"
    }


}
